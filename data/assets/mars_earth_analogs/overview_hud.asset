-- OpenSpace ScreenSpace Overview & Comparison HUD Asset
-- Projects semi-translucent overview cards directly into the 3D viewport (empty space of screen)
-- Flat screen-facing orientation (FaceCamera = true, Rotation = {0,0,0})
-- Scale = 0.72 and CartesianPosition = {-0.22, 0.02, -2.0} ensures HUD fits clearly and legibly in the middle viewport
-- Enabled = true ensures the General Location Overview is visible immediately on load

local defaultTexture = asset.resource("./textures/hud_overview_location_mars_gale.png")

local OverviewHUD = {
  Type = "ScreenSpaceImageLocal",
  Identifier = "OverviewHUD",
  Name = "Overview Comparison HUD",
  TexturePath = defaultTexture,
  Enabled = true,
  Opacity = 0.94,
  Placement = {
    CartesianPosition = { -0.22, 0.02, -2.0 },
    Scale = 0.72,
    FaceCamera = true,
    Rotation = { 0.0, 0.0, 0.0 }
  }
}

asset.onInitialize(function()
  if openspace.hasProperty("ScreenSpace.OverviewHUD.Enabled") then
    openspace.removeScreenSpaceRenderable("OverviewHUD")
  end
  openspace.addScreenSpaceRenderable(OverviewHUD)
end)

asset.onDeinitialize(function()
  openspace.removeScreenSpaceRenderable("OverviewHUD")
end)

asset.export("OverviewHUD", OverviewHUD)
