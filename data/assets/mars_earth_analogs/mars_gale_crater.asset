local LocationTagTexture = asset.resource("./textures/location_tag.png")

local MarsGaleTagNode = {
  Identifier = "MarsTagGaleCrater",
  Parent = "Mars",
  Transform = {
    Translation = {
      Type = "GlobeTranslation",
      Globe = "Mars",
      Latitude = -4.5895,
      Longitude = 137.4417,
      Altitude = 1200.0,
      UseHeightmap = true
    }
  },
  Renderable = {
    Type = "RenderablePlaneImageLocal",
    Enabled = true,
    Texture = LocationTagTexture,
    Billboard = true,
    MultiplyColor = { 1.0, 0.40, 0.10 },
    BlendMode = "Normal",
    Size = 100000,
    DistanceScalingSettings = {
      ScaleByDistance = true,
      ApparentSizeMultiplier = 0.035,
      ScaleByDistanceMaxHeight = 350000.0,
      ScaleByDistanceMinHeight = 2500.0
    }
  },
  GUI = {
    Name = "Mars Gale Crater Curiosity Tag",
    Path = "/Planets/Mars/Surface Features"
  }
}

local MarsGaleLabelNode = {
  Identifier = "MarsGaleCraterLabel",
  Parent = "Mars",
  Transform = {
    Translation = {
      Type = "GlobeTranslation",
      Globe = "Mars",
      Latitude = -4.5895,
      Longitude = 137.4417,
      Altitude = 4500.0,
      UseHeightmap = true
    }
  },
  Renderable = {
    Type = "RenderableLabel",
    Enabled = true,
    Text = "Mars: Gale Crater",
    FontSize = 36.0,
    Color = { 1.0, 0.85, 0.40 },
    MinMaxSize = { 0, 36 },
    EnableFading = true,
    FadeUnit = "Km",
    FadeDistances = { 50.0, 35000.0 },
    FadeWidths = { 20.0, 5000.0 },
    OrientationOption = "Camera View Direction",
    BlendMode = "Normal"
  },
  GUI = {
    Name = "Mars Gale Crater Label",
    Path = "/Planets/Mars/Surface Features"
  }
}

asset.onInitialize(function()
  openspace.addSceneGraphNode(MarsGaleTagNode)
  openspace.addSceneGraphNode(MarsGaleLabelNode)
end)

asset.onDeinitialize(function()
  openspace.removeSceneGraphNode("MarsGaleCraterLabel")
  openspace.removeSceneGraphNode("MarsTagGaleCrater")
end)

asset.export("MarsGaleTagNode", MarsGaleTagNode)
asset.export("MarsGaleLabelNode", MarsGaleLabelNode)
