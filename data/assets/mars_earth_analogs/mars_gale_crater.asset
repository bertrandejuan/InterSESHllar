local GaleCraterBoundaryFile = asset.resource("./geojson/mars_gale_crater_boundary.geojson")
local GaleCraterPinFile = asset.resource("./geojson/mars_gale_crater_pin.geojson")

local GaleCraterBoundaryTable = {
  Identifier = "MarsGaleCraterBoundaries",
  File = GaleCraterBoundaryFile,
  Enabled = true,
  HeightOffset = 120.0,
  LineWidthScale = 2.5,
  DefaultProperties = {
    Color = { 1.0, 0.35, 0.08 },
    FillColor = { 1.0, 0.35, 0.08 },
    FillOpacity = 0.04,
    LineWidth = 7.0,
    Opacity = 1.0
  }
}

local GaleCraterPinTable = {
  Identifier = "MarsGaleCraterPin",
  File = GaleCraterPinFile,
  Enabled = true,
  HeightOffset = 60.0,
  PointRenderMode = "Camera Position",
  DefaultProperties = {
    Color = { 1.0, 0.35, 0.08 },
    PointSize = 24.0,
    Extrude = true
  }
}

local GaleCraterLabelNode = {
  Identifier = "MarsGaleCraterLabel",
  Parent = "Mars",
  Transform = {
    Translation = {
      Type = "GlobeTranslation",
      Globe = "Mars",
      Latitude = -4.5895,
      Longitude = 137.4417,
      Altitude = 15000.0,
      UseHeightmap = true
    }
  },
  Renderable = {
    Type = "RenderableLabel",
    Enabled = true,
    Text = "Gale Crater Center (MSL Curiosity / Bradbury Landing)",
    FontSize = 32.0,
    Color = { 1.0, 0.85, 0.65 },
    MinMaxSize = { 12, 48 },
    EnableFading = true,
    FadeDistances = { 80.0, 3000.0 },
    FadeWidths = { 50.0, 800.0 },
    FadeUnit = "Km"
  },
  GUI = {
    Name = "Mars Gale Crater Label",
    Path = "/Planets/Mars/Surface Features"
  }
}

asset.onInitialize(function()
  openspace.globebrowsing.addGeoJson("Mars", GaleCraterBoundaryTable)
  openspace.globebrowsing.addGeoJson("Mars", GaleCraterPinTable)
  openspace.addSceneGraphNode(GaleCraterLabelNode)
end)

asset.onDeinitialize(function()
  openspace.removeSceneGraphNode("MarsGaleCraterLabel")
  openspace.globebrowsing.deleteGeoJson("Mars", GaleCraterPinTable)
  openspace.globebrowsing.deleteGeoJson("Mars", GaleCraterBoundaryTable)
end)

asset.export("GaleCraterBoundaryTable", GaleCraterBoundaryTable)
asset.export("GaleCraterPinTable", GaleCraterPinTable)
