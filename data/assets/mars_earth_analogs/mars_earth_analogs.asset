-- OpenSpace Mars & Earth Desert Analogs Visualization Asset
-- Master Orchestration Asset

local marsGale = asset.require("./mars_gale_crater")
local earthAnalogs = asset.require("./earth_desert_analogs")
local cameraPaths = asset.require("./tour_camera_paths")
local teamDataAsset = asset.require("./data/team_analog_data")
local globeOverlays = asset.require("./analog_globe_overlays")
local overviewHUD = asset.require("./overview_hud")

asset.onInitialize(function()
  openspace.printInfo("Loaded Mars Gale Crater & Earth Desert Analogs with Team 10-Yr Planetary Surface Data Overlays.")

  -- "On opening: Set illumination for earth and mars." (Storyboard requirement)
  if openspace.hasProperty("Scene.Earth.Renderable.PerformShading") then
    openspace.setPropertyValueSingle("Scene.Earth.Renderable.PerformShading", false)
  end
  if openspace.hasProperty("Scene.Mars.Renderable.PerformShading") then
    openspace.setPropertyValueSingle("Scene.Mars.Renderable.PerformShading", false)
  end
  if openspace.hasProperty("Scene.EarthAtmosphere.Renderable.SunFollowingCamera") then
    openspace.setPropertyValueSingle("Scene.EarthAtmosphere.Renderable.SunFollowingCamera", true)
  end
  if openspace.hasProperty("Scene.MarsAtmosphere.Renderable.SunFollowingCamera") then
    openspace.setPropertyValueSingle("Scene.MarsAtmosphere.Renderable.SunFollowingCamera", true)
  end

  -- Automatically enable best satellite imagery & 3D terrain on Earth
  if openspace.hasProperty("Scene.Earth.Renderable.Layers.ColorLayers.ESRI_World_Imagery.Enabled") then
    openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.ColorLayers.ESRI_World_Imagery.Enabled", true)
  end
  if openspace.hasProperty("Scene.Earth.Renderable.Layers.HeightLayers.Terrain_Tileset.Enabled") then
    openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.HeightLayers.Terrain_Tileset.Enabled", true)
  end

  -- Automatically enable best satellite imagery on Mars
  if openspace.hasProperty("Scene.Mars.Renderable.Layers.ColorLayers.CTX_blended.Enabled") then
    openspace.setPropertyValueSingle("Scene.Mars.Renderable.Layers.ColorLayers.CTX_blended.Enabled", true)
  end
  if openspace.hasProperty("Scene.Mars.Renderable.Layers.ColorLayers.CTX_Blended.Enabled") then
    openspace.setPropertyValueSingle("Scene.Mars.Renderable.Layers.ColorLayers.CTX_Blended.Enabled", true)
  end

  -- Boost LOD scale factor so high-resolution surface tiles stream in early
  if openspace.hasProperty("Scene.Earth.Renderable.LodScaleFactor") then
    openspace.setPropertyValueSingle("Scene.Earth.Renderable.LodScaleFactor", 15.0)
  end
  if openspace.hasProperty("Scene.Mars.Renderable.LodScaleFactor") then
    openspace.setPropertyValueSingle("Scene.Mars.Renderable.LodScaleFactor", 15.0)
  end

  -- Disable unnecessary celestial systems so view only contains Earth, Mars, and background stars
  local disabledBodies = {
    "Mercury", "Venus", "Moon", "Jupiter", "Saturn", "Uranus", "Neptune", "Pluto",
    "SunGlare", "Ceres", "Vesta", "Bennu", "Ryugu", "Io", "Europa", "Ganymede",
    "Callisto", "Titan", "Enceladus", "Mimas", "Rhea", "Iapetus", "Dione", "Tethys",
    "Phobos", "Deimos", "LocalDwarfGalaxies", "Galaxies", "Tully", "SloanDigitalSkySurvey",
    "ConstellationBounds", "Constellations"
  }
  for _, b in ipairs(disabledBodies) do
    if openspace.hasProperty("Scene." .. b .. ".Renderable.Enabled") then
      openspace.setPropertyValueSingle("Scene." .. b .. ".Renderable.Enabled", false)
    end
    if openspace.hasProperty("Scene." .. b .. "Trail.Renderable.Enabled") then
      openspace.setPropertyValueSingle("Scene." .. b .. "Trail.Renderable.Enabled", false)
    end
    if openspace.hasProperty("Scene." .. b .. ".Enabled") then
      openspace.setPropertyValueSingle("Scene." .. b .. ".Enabled", false)
    end
  end

  local trailsToDisable = {
    "MercuryTrail", "VenusTrail", "EarthTrail", "MarsTrail", "MoonTrail",
    "JupiterTrail", "SaturnTrail", "UranusTrail", "NeptuneTrail", "PlutoTrail"
  }
  for _, t in ipairs(trailsToDisable) do
    if openspace.hasProperty("Scene." .. t .. ".Renderable.Enabled") then
      openspace.setPropertyValueSingle("Scene." .. t .. ".Renderable.Enabled", false)
    end
  end

  -- Initial focus on Mars Gale Crater
  openspace.navigation.flyToGeo("Mars", -4.5895, 137.4417, 1200000, 3)
end)

asset.onDeinitialize(function()
  openspace.printInfo("Unloaded Mars Gale Crater & Earth Desert Analogs Visualization Asset.")
end)

asset.export("TeamData", teamDataAsset.TeamData)
