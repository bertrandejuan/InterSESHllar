local AnalogSites = {
  MarsGale = { Globe = "Mars", Lat = -4.5895, Lon = 137.4417, Alt = 550000, Name = "Mars: Gale Crater" },
  Aralkum = { Globe = "Earth", Lat = 44.80, Lon = 59.80, Alt = 850000, Name = "Earth: Aralkum Desert" },
  McMurdo = { Globe = "Earth", Lat = -77.50, Lon = 162.00, Alt = 650000, Name = "Earth: McMurdo Dry Valleys" },
  Lut = { Globe = "Earth", Lat = 30.50, Lon = 58.80, Alt = 850000, Name = "Earth: Lut Desert" },
  Uyuni = { Globe = "Earth", Lat = -20.15, Lon = -67.60, Alt = 650000, Name = "Earth: Salar de Uyuni" }
}

local Actions = {
  {
    Identifier = "mars_earth.ToggleTags",
    Name = "Toggle Location Tags & Markers",
    Command = [[
      local tags = { "Scene.EarthTagAralkum", "Scene.EarthTagMcMurdo", "Scene.EarthTagLut", "Scene.EarthTagUyuni", "Scene.MarsTagGaleCrater" }
      local e = false
      if openspace.hasProperty("Scene.EarthTagAralkum.Renderable.Enabled") then
        e = openspace.propertyValue("Scene.EarthTagAralkum.Renderable.Enabled")
      end
      local newState = not e
      for _, tag in ipairs(tags) do
        if openspace.hasProperty(tag .. ".Renderable.Enabled") then
          openspace.setPropertyValueSingle(tag .. ".Renderable.Enabled", newState)
        end
      end
    ]],
    Documentation = "Toggles visibility for all planetary location tags",
    GuiPath = "/Planetary Analogs/Toggles",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.ToggleLabels",
    Name = "Toggle 3D Billboard Text Labels",
    Command = [[
      local labels = { "Scene.EarthLabelAralkum", "Scene.EarthLabelMcMurdo", "Scene.EarthLabelLut", "Scene.EarthLabelUyuni", "Scene.MarsGaleCraterLabel" }
      local e = false
      if openspace.hasProperty("Scene.EarthLabelAralkum.Renderable.Enabled") then
        e = openspace.propertyValue("Scene.EarthLabelAralkum.Renderable.Enabled")
      end
      local newState = not e
      for _, l in ipairs(labels) do
        if openspace.hasProperty(l .. ".Renderable.Enabled") then
          openspace.setPropertyValueSingle(l .. ".Renderable.Enabled", newState)
        end
      end
    ]],
    Documentation = "Toggles visibility for 3D billboard text labels",
    GuiPath = "/Planetary Analogs/Toggles",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyMarsGale",
    Name = "Fly to Mars: Gale Crater",
    Command = [[
      openspace.navigation.flyToGeo('Mars', -4.5895, 137.4417, 550000, 4.0)
      if openspace.hasProperty("Scene.MarsTagGaleCrater.Renderable.Enabled") then
        openspace.setPropertyValueSingle("Scene.MarsTagGaleCrater.Renderable.Enabled", true)
      end
      if openspace.hasProperty("Scene.MarsGaleCraterLabel.Renderable.Enabled") then
        openspace.setPropertyValueSingle("Scene.MarsGaleCraterLabel.Renderable.Enabled", true)
      end
    ]],
    Documentation = "Fly close to Gale Crater with high-res CTX satellite imagery and location tag",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyAralkum",
    Name = "Fly to Earth: Aralkum Desert",
    Command = [[
      openspace.navigation.flyToGeo('Earth', 44.80, 59.80, 850000, 4.0)
      if openspace.hasProperty("Scene.EarthTagAralkum.Renderable.Enabled") then
        openspace.setPropertyValueSingle("Scene.EarthTagAralkum.Renderable.Enabled", true)
      end
      if openspace.hasProperty("Scene.EarthLabelAralkum.Renderable.Enabled") then
        openspace.setPropertyValueSingle("Scene.EarthLabelAralkum.Renderable.Enabled", true)
      end
    ]],
    Documentation = "Fly close to Aralkum Desert with high-res ESRI imagery and location tag",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyMcMurdo",
    Name = "Fly to Earth: McMurdo Dry Valleys",
    Command = [[
      openspace.navigation.flyToGeo('Earth', -77.50, 162.00, 650000, 4.0)
      if openspace.hasProperty("Scene.EarthTagMcMurdo.Renderable.Enabled") then
        openspace.setPropertyValueSingle("Scene.EarthTagMcMurdo.Renderable.Enabled", true)
      end
      if openspace.hasProperty("Scene.EarthLabelMcMurdo.Renderable.Enabled") then
        openspace.setPropertyValueSingle("Scene.EarthLabelMcMurdo.Renderable.Enabled", true)
      end
    ]],
    Documentation = "Fly close to McMurdo Dry Valleys with high-res imagery and location tag",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyLut",
    Name = "Fly to Earth: Lut Desert",
    Command = [[
      openspace.navigation.flyToGeo('Earth', 30.50, 58.80, 850000, 4.0)
      if openspace.hasProperty("Scene.EarthTagLut.Renderable.Enabled") then
        openspace.setPropertyValueSingle("Scene.EarthTagLut.Renderable.Enabled", true)
      end
      if openspace.hasProperty("Scene.EarthLabelLut.Renderable.Enabled") then
        openspace.setPropertyValueSingle("Scene.EarthLabelLut.Renderable.Enabled", true)
      end
    ]],
    Documentation = "Fly close to Lut Desert with high-res imagery and location tag",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyUyuni",
    Name = "Fly to Earth: Salar de Uyuni",
    Command = [[
      openspace.navigation.flyToGeo('Earth', -20.15, -67.60, 650000, 4.0)
      if openspace.hasProperty("Scene.EarthTagUyuni.Renderable.Enabled") then
        openspace.setPropertyValueSingle("Scene.EarthTagUyuni.Renderable.Enabled", true)
      end
      if openspace.hasProperty("Scene.EarthLabelUyuni.Renderable.Enabled") then
        openspace.setPropertyValueSingle("Scene.EarthLabelUyuni.Renderable.Enabled", true)
      end
    ]],
    Documentation = "Fly close to Salar de Uyuni with high-res imagery and location tag",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.RestoreOrbit",
    Name = "Return to High Planetary Orbit",
    Command = [[
      local focus = openspace.navigation.getNavigationState().Anchor
      if focus == "Mars" then
        openspace.navigation.flyToGeo('Mars', 0, 137.4, 5000000, 3.0)
      else
        openspace.navigation.flyToGeo('Earth', 20, 60, 8000000, 3.0)
      end
    ]],
    Documentation = "Return to wide-angle global planetary orbit",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  }
}

asset.onInitialize(function()
  for _, action in ipairs(Actions) do
    if openspace.action.hasAction(action.Identifier) then
      openspace.action.removeAction(action.Identifier)
    end
    openspace.action.registerAction(action)
  end

  openspace.bindKey("Ctrl+Alt+M", "mars_earth.FlyMarsGale")
  openspace.bindKey("Ctrl+Alt+1", "mars_earth.FlyAralkum")
  openspace.bindKey("Ctrl+Alt+2", "mars_earth.FlyMcMurdo")
  openspace.bindKey("Ctrl+Alt+3", "mars_earth.FlyLut")
  openspace.bindKey("Ctrl+Alt+4", "mars_earth.FlyUyuni")
  openspace.bindKey("Ctrl+Alt+0", "mars_earth.RestoreOrbit")
end)

asset.onDeinitialize(function()
  if openspace.clearKey then
    openspace.clearKey("Ctrl+Alt+M")
    openspace.clearKey("Ctrl+Alt+1")
    openspace.clearKey("Ctrl+Alt+2")
    openspace.clearKey("Ctrl+Alt+3")
    openspace.clearKey("Ctrl+Alt+4")
    openspace.clearKey("Ctrl+Alt+0")
  end

  for _, action in ipairs(Actions) do
    if openspace.action.hasAction(action.Identifier) then
      openspace.action.removeAction(action.Identifier)
    end
  end
end)

asset.export("Sites", AnalogSites)
