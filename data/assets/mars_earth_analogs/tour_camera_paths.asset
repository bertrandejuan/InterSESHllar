local AnalogSites = {
  { id = "mars_gale", name = "Mars: Gale Crater", globe = "Mars", lat = -4.5895, lon = 137.4417, alt = 150000, duration = 3.5 },
  { id = "aralkum", name = "Earth: Aralkum Desert", globe = "Earth", lat = 44.5, lon = 58.5, alt = 150000, duration = 3.5 },
  { id = "mcmurdo", name = "Earth: McMurdo Dry Valleys", globe = "Earth", lat = -77.5, lon = 162.0, alt = 140000, duration = 3.5 },
  { id = "lut", name = "Earth: Lut Desert", globe = "Earth", lat = 30.5, lon = 58.8, alt = 120000, duration = 3.5 },
  { id = "uyuni", name = "Earth: Salar de Uyuni", globe = "Earth", lat = -20.15, lon = -67.6, alt = 120000, duration = 3.5 }
}

-- Native OpenSpace GUI Actions
local Actions = {
  {
    Identifier = "mars_earth.ToggleBoundaries",
    Name = "Toggle Desert Boundaries",
    Command = [[
      if openspace.hasProperty("Scene.Earth.Renderable.GeographicOverlays.EarthDesertBoundaries.Enabled") then
        local e = openspace.propertyValue("Scene.Earth.Renderable.GeographicOverlays.EarthDesertBoundaries.Enabled")
        openspace.setPropertyValueSingle("Scene.Earth.Renderable.GeographicOverlays.EarthDesertBoundaries.Enabled", not e)
      end
      if openspace.hasProperty("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterBoundaries.Enabled") then
        local m = openspace.propertyValue("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterBoundaries.Enabled")
        openspace.setPropertyValueSingle("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterBoundaries.Enabled", not m)
      end
    ]],
    Documentation = "Toggles visibility for Mars Gale Crater & Earth Desert boundaries",
    GuiPath = "/Planetary Analogs/Toggles",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.TogglePins",
    Name = "Toggle Station Pins",
    Command = [[
      if openspace.hasProperty("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled") then
        local e = openspace.propertyValue("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled")
        openspace.setPropertyValueSingle("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled", not e)
      end
      if openspace.hasProperty("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterPin.Enabled") then
        local m = openspace.propertyValue("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterPin.Enabled")
        openspace.setPropertyValueSingle("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterPin.Enabled", not m)
      end
    ]],
    Documentation = "Toggles visibility for Mars Gale Crater & Earth Station pins",
    GuiPath = "/Planetary Analogs/Toggles",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.RestorePinsAndOrbit",
    Name = "Restore All Pins & Return to Orbit Overview",
    Command = [[
      if openspace.hasProperty("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled") then
        openspace.setPropertyValueSingle("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled", true)
      end
      if openspace.hasProperty("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterPin.Enabled") then
        openspace.setPropertyValueSingle("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterPin.Enabled", true)
      end
      openspace.navigation.flyToGeo('Earth', 20.0, 60.0, 8000000, 3.5)
    ]],
    Documentation = "Restores all station pins and returns camera to high orbital view",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.ShowAllPinsOrbit",
    Name = "Show All Pins (Orbit Overview)",
    Command = [[
      if openspace.hasProperty("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled") then
        openspace.setPropertyValueSingle("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled", true)
      end
      if openspace.hasProperty("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterPin.Enabled") then
        openspace.setPropertyValueSingle("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterPin.Enabled", true)
      end
    ]],
    Documentation = "Shows all research station pins on Earth and Mars",
    GuiPath = "/Planetary Analogs/Toggles",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.ToggleLabels",
    Name = "Toggle 3D Billboard Labels",
    Command = [[
      local e = false
      if openspace.hasProperty("Scene.EarthLabelAralkum.Renderable.Enabled") then
        e = openspace.propertyValue("Scene.EarthLabelAralkum.Renderable.Enabled")
      end
      local newState = not e
      local labels = { "Scene.EarthLabelAralkum", "Scene.EarthLabelMcMurdo", "Scene.EarthLabelLut", "Scene.EarthLabelUyuni", "Scene.MarsGaleCraterLabel" }
      for _, l in ipairs(labels) do
        if openspace.hasProperty(l .. ".Renderable.Enabled") then
          openspace.setPropertyValueSingle(l .. ".Renderable.Enabled", newState)
        end
      end
    ]],
    Documentation = "Toggles visibility for 3D billboard text labels",
    GuiPath = "/Planetary Analogs/Toggles",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyMarsGale",
    Name = "Fly to Mars: Gale Crater (Inspect High-Res Imagery)",
    Command = [[
      openspace.navigation.flyToGeo('Mars', -4.5895, 137.4417, 150000, 3.5)
      if openspace.hasProperty("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterPin.Enabled") then
        openspace.setPropertyValueSingle("Scene.Mars.Renderable.GeographicOverlays.MarsGaleCraterPin.Enabled", false)
      end
    ]],
    Documentation = "Fly close to Gale Crater with pin hidden for unobstructed satellite viewing",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyAralkum",
    Name = "Fly to Earth: Aralkum Desert (Inspect High-Res Imagery)",
    Command = [[
      openspace.navigation.flyToGeo('Earth', 44.5, 58.5, 150000, 3.5)
      if openspace.hasProperty("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled") then
        openspace.setPropertyValueSingle("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled", false)
      end
    ]],
    Documentation = "Fly close to Aralkum Desert with pin hidden for unobstructed satellite viewing",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyMcMurdo",
    Name = "Fly to Earth: McMurdo Dry Valleys (Inspect High-Res Imagery)",
    Command = [[
      openspace.navigation.flyToGeo('Earth', -77.5, 162.0, 140000, 3.5)
      if openspace.hasProperty("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled") then
        openspace.setPropertyValueSingle("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled", false)
      end
    ]],
    Documentation = "Fly close to McMurdo Dry Valleys with pin hidden for unobstructed satellite viewing",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyLut",
    Name = "Fly to Earth: Lut Desert (Inspect High-Res Imagery)",
    Command = [[
      openspace.navigation.flyToGeo('Earth', 30.5, 58.8, 120000, 3.5)
      if openspace.hasProperty("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled") then
        openspace.setPropertyValueSingle("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled", false)
      end
    ]],
    Documentation = "Fly close to Lut Desert with pin hidden for unobstructed satellite viewing",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyUyuni",
    Name = "Fly to Earth: Salar de Uyuni (Inspect High-Res Imagery)",
    Command = [[
      openspace.navigation.flyToGeo('Earth', -20.15, -67.6, 120000, 3.5)
      if openspace.hasProperty("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled") then
        openspace.setPropertyValueSingle("Scene.Earth.Renderable.GeographicOverlays.EarthDesertPins.Enabled", false)
      end
    ]],
    Documentation = "Fly close to Salar de Uyuni with pin hidden for unobstructed satellite viewing",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  }
}

asset.onInitialize(function()
  for _, action in ipairs(Actions) do
    openspace.action.registerAction(action)
  end

  openspace.bindKey("Ctrl+Alt+M", "mars_earth.FlyMarsGale")
  openspace.bindKey("Ctrl+Alt+1", "mars_earth.FlyAralkum")
  openspace.bindKey("Ctrl+Alt+2", "mars_earth.FlyMcMurdo")
  openspace.bindKey("Ctrl+Alt+3", "mars_earth.FlyLut")
  openspace.bindKey("Ctrl+Alt+4", "mars_earth.FlyUyuni")
  openspace.bindKey("Ctrl+Alt+0", "mars_earth.RestorePinsAndOrbit")
end)

asset.onDeinitialize(function()
  openspace.unbindKey("Ctrl+Alt+M")
  openspace.unbindKey("Ctrl+Alt+1")
  openspace.unbindKey("Ctrl+Alt+2")
  openspace.unbindKey("Ctrl+Alt+3")
  openspace.unbindKey("Ctrl+Alt+4")
  openspace.unbindKey("Ctrl+Alt+0")

  for _, action in ipairs(Actions) do
    openspace.action.removeAction(action.Identifier)
  end
end)

asset.export("Sites", AnalogSites)
