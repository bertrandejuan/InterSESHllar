local AnalogSites = {
  { id = "mars_gale", name = "Mars: Gale Crater", globe = "Mars", lat = -4.5895, lon = 137.4417, alt = 350000, duration = 4.0 },
  { id = "aralkum", name = "Earth: Aralkum Desert", globe = "Earth", lat = 44.5, lon = 58.5, alt = 450000, duration = 4.0 },
  { id = "mcmurdo", name = "Earth: McMurdo Dry Valleys", globe = "Earth", lat = -77.5, lon = 162.0, alt = 400000, duration = 4.0 },
  { id = "lut", name = "Earth: Lut Desert", globe = "Earth", lat = 30.5, lon = 58.8, alt = 380000, duration = 4.0 },
  { id = "uyuni", name = "Earth: Salar de Uyuni", globe = "Earth", lat = -20.15, lon = -67.6, alt = 360000, duration = 4.0 }
}

-- Native OpenSpace GUI Actions
local Actions = {
  {
    Identifier = "mars_earth.ToggleBoundaries",
    Name = "Toggle Desert Boundaries",
    Command = [[
      local e = openspace.propertyValue("Scene.Earth.Renderable.GeoJson.EarthDesertBoundaries.Enabled")
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.GeoJson.EarthDesertBoundaries.Enabled", not e)
      if openspace.hasProperty("Scene.Mars.Renderable.GeoJson.MarsGaleCraterBoundaries.Enabled") then
        openspace.setPropertyValueSingle("Scene.Mars.Renderable.GeoJson.MarsGaleCraterBoundaries.Enabled", not e)
      end
    ]],
    Documentation = "Toggles visibility for Mars Gale Crater & Earth Desert boundaries",
    GuiPath = "/Planetary Analogs/Toggles",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.TogglePins",
    Name = "Toggle Station Pins",
    Command = [[
      local e = openspace.propertyValue("Scene.Earth.Renderable.GeoJson.EarthDesertPins.Enabled")
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.GeoJson.EarthDesertPins.Enabled", not e)
      if openspace.hasProperty("Scene.Mars.Renderable.GeoJson.MarsGaleCraterPin.Enabled") then
        openspace.setPropertyValueSingle("Scene.Mars.Renderable.GeoJson.MarsGaleCraterPin.Enabled", not e)
      end
    ]],
    Documentation = "Toggles visibility for Mars Gale Crater & Earth Station pins",
    GuiPath = "/Planetary Analogs/Toggles",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.ToggleLabels",
    Name = "Toggle 3D Billboard Labels",
    Command = [[
      local e = openspace.propertyValue("Scene.EarthLabelAralkum.Renderable.Enabled")
      local newState = not e
      local labels = { "Scene.EarthLabelAralkum", "Scene.EarthLabelMcMurdo", "Scene.EarthLabelLut", "Scene.EarthLabelUyuni", "Scene.MarsGaleCraterLabel" }
      for _, l in ipairs(labels) do
        if openspace.hasProperty(l .. ".Renderable.Enabled") then
          openspace.setPropertyValueSingle(l .. ".Renderable.Enabled", newState)
        end
      end
    ]],
    Documentation = "Toggles visibility for 3D billboard text labels",
    GuiPath = "/Planetary Analogs/Toggles",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyMarsGale",
    Name = "Fly to Mars: Gale Crater",
    Command = "openspace.navigation.flyToGeo('Mars', -4.5895, 137.4417, 350000, 4)",
    Documentation = "Fly camera to Mars Gale Crater (Curiosity MSL Site)",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyAralkum",
    Name = "Fly to Earth: Aralkum Desert",
    Command = "openspace.navigation.flyToGeo('Earth', 44.5, 58.5, 450000, 4)",
    Documentation = "Fly camera to Aralkum Desert (Uzbekistan)",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyMcMurdo",
    Name = "Fly to Earth: McMurdo Dry Valleys",
    Command = "openspace.navigation.flyToGeo('Earth', -77.5, 162.0, 400000, 4)",
    Documentation = "Fly camera to McMurdo Dry Valleys (Antarctica)",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyLut",
    Name = "Fly to Earth: Lut Desert",
    Command = "openspace.navigation.flyToGeo('Earth', 30.5, 58.8, 380000, 4)",
    Documentation = "Fly camera to Lut Desert (Iran)",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  },
  {
    Identifier = "mars_earth.FlyUyuni",
    Name = "Fly to Earth: Salar de Uyuni",
    Command = "openspace.navigation.flyToGeo('Earth', -20.15, -67.6, 360000, 4)",
    Documentation = "Fly camera to Salar de Uyuni (Bolivia)",
    GuiPath = "/Planetary Analogs/Navigation",
    IsLocal = false
  }
}

asset.onInitialize(function()
  -- Register Actions for OpenSpace GUI
  for _, action in ipairs(Actions) do
    openspace.action.registerAction(action)
  end

  -- Keybindings (exactly 2 arguments required by OpenSpace bindKey)
  openspace.bindKey("Ctrl+Alt+M", "openspace.navigation.flyToGeo('Mars', -4.5895, 137.4417, 350000, 4)")
  openspace.bindKey("Ctrl+Alt+1", "openspace.navigation.flyToGeo('Earth', 44.5, 58.5, 450000, 4)")
  openspace.bindKey("Ctrl+Alt+2", "openspace.navigation.flyToGeo('Earth', -77.5, 162.0, 400000, 4)")
  openspace.bindKey("Ctrl+Alt+3", "openspace.navigation.flyToGeo('Earth', 30.5, 58.8, 380000, 4)")
  openspace.bindKey("Ctrl+Alt+4", "openspace.navigation.flyToGeo('Earth', -20.15, -67.6, 360000, 4)")
end)

asset.onDeinitialize(function()
  openspace.unbindKey("Ctrl+Alt+M")
  openspace.unbindKey("Ctrl+Alt+1")
  openspace.unbindKey("Ctrl+Alt+2")
  openspace.unbindKey("Ctrl+Alt+3")
  openspace.unbindKey("Ctrl+Alt+4")

  for _, action in ipairs(Actions) do
    openspace.action.removeAction(action.Identifier)
  end
end)

asset.export("Sites", AnalogSites)
