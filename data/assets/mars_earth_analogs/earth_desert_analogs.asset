local LocationTagTexture = asset.resource("./textures/location_tag.png")
local teamDataAsset = asset.require("./data/team_analog_data")
local TeamData = teamDataAsset.TeamData

local DesertSites = {
  {
    SiteKey = "aralkum",
    TagId = "EarthTagAralkum",
    LabelId = "EarthLabelAralkum",
    Name = "Aralkum Desert",
    LabelText = "Aralkum Desert Station",
    Globe = "Earth",
    Lat = 44.80,
    Lon = 59.80,
    Alt = 1500.0,
    LabelAlt = 4500.0,
    Color = { 0.20, 0.90, 0.45 },
    TeamMetrics = TeamData.aralkum.metrics
  },
  {
    SiteKey = "mcmurdo",
    TagId = "EarthTagMcMurdo",
    LabelId = "EarthLabelMcMurdo",
    Name = "McMurdo Dry Valleys",
    LabelText = "McMurdo Dry Valleys Station",
    Globe = "Earth",
    Lat = -77.50,
    Lon = 162.00,
    Alt = 1500.0,
    LabelAlt = 4500.0,
    Color = { 0.15, 0.80, 1.00 },
    TeamMetrics = TeamData.mcmurdo.metrics
  },
  {
    SiteKey = "lut",
    TagId = "EarthTagLut",
    LabelId = "EarthLabelLut",
    Name = "Lut Desert",
    LabelText = "Lut Desert Thermal Station",
    Globe = "Earth",
    Lat = 30.50,
    Lon = 58.80,
    Alt = 1500.0,
    LabelAlt = 4500.0,
    Color = { 1.00, 0.65, 0.10 },
    TeamMetrics = TeamData.lut.metrics
  },
  {
    SiteKey = "uyuni",
    TagId = "EarthTagUyuni",
    LabelId = "EarthLabelUyuni",
    Name = "Salar de Uyuni",
    LabelText = "Salar de Uyuni Station",
    Globe = "Earth",
    Lat = -20.15,
    Lon = -67.60,
    Alt = 1500.0,
    LabelAlt = 4500.0,
    Color = { 0.85, 0.45, 1.00 },
    TeamMetrics = TeamData.uyuni.metrics
  }
}

asset.onInitialize(function()
  openspace.printInfo("Loaded Earth Desert Analogs with Team In-Situ Datasets (4,018 daily observations/site).")
  for _, site in ipairs(DesertSites) do
    -- 1. Adaptive Location Tag Marker (Large when zoomed out, smaller as you zoom in)
    openspace.addSceneGraphNode({
      Identifier = site.TagId,
      Parent = site.Globe,
      Transform = {
        Translation = {
          Type = "GlobeTranslation",
          Globe = site.Globe,
          Latitude = site.Lat,
          Longitude = site.Lon,
          Altitude = site.Alt,
          UseHeightmap = true
        }
      },
      Renderable = {
        Type = "RenderablePlaneImageLocal",
        Enabled = true,
        Texture = LocationTagTexture,
        Billboard = true,
        MultiplyColor = site.Color,
        BlendMode = "Normal",
        Size = 100000,
        DistanceScalingSettings = {
          ScaleByDistance = true,
          ApparentSizeMultiplier = 0.035,
          ScaleByDistanceMaxHeight = 350000.0,
          ScaleByDistanceMinHeight = 2500.0
        }
      },
      GUI = {
        Name = site.Name .. " Location Tag",
        Path = "/Planets/Earth/Mars Analog Sites"
      }
    })

    -- 2. 3D Billboard Location Label on Screen
    openspace.addSceneGraphNode({
      Identifier = site.LabelId,
      Parent = site.Globe,
      Transform = {
        Translation = {
          Type = "GlobeTranslation",
          Globe = site.Globe,
          Latitude = site.Lat,
          Longitude = site.Lon,
          Altitude = site.LabelAlt,
          UseHeightmap = true
        }
      },
      Renderable = {
        Type = "RenderableLabel",
        Enabled = true,
        Text = site.LabelText,
        FontSize = 32.0,
        Color = site.Color,
        MinMaxSize = { 12, 38 },
        OrientationOption = "Camera View Direction",
        BlendMode = "Additive"
      },
      GUI = {
        Name = site.Name .. " Label",
        Path = "/Planets/Earth/Mars Analog Sites"
      }
    })
  end
end)

asset.onDeinitialize(function()
  for _, site in ipairs(DesertSites) do
    openspace.removeSceneGraphNode(site.LabelId)
    openspace.removeSceneGraphNode(site.TagId)
  end
end)

asset.export("DesertSites", DesertSites)
asset.export("TeamData", TeamData)
