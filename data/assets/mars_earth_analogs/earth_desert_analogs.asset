local LocationTagTexture = asset.resource("./textures/location_tag.png")
local teamDataAsset = asset.require("./data/team_analog_data")
local TeamData = teamDataAsset.TeamData

-- The 4 Premier Earth Planetary Desert Analogs
local DesertSites = {
  {
    SiteKey = "aralkum",
    TagId = "EarthTagAralkum",
    LabelId = "EarthLabelAralkum",
    Name = "Aralkum Desert Station",
    LabelText = "Aralkum Desert (Uzbekistan)",
    Globe = "Earth",
    Lat = 44.80,
    Lon = 59.80,
    Alt = 1500.0,
    LabelAlt = 4500.0,
    Color = { 0.20, 0.90, 0.45 },
    TeamMetrics = TeamData.aralkum.metrics
  },
  {
    SiteKey = "mcmurdo",
    TagId = "EarthTagMcMurdo",
    LabelId = "EarthLabelMcMurdo",
    Name = "McMurdo Dry Valleys Station",
    LabelText = "McMurdo Valleys (Antarctica)",
    Globe = "Earth",
    Lat = -77.50,
    Lon = 162.00,
    Alt = 1800.0,
    LabelAlt = 4800.0,
    Color = { 0.15, 0.80, 1.00 },
    TeamMetrics = TeamData.mcmurdo.metrics
  },
  {
    SiteKey = "lut",
    TagId = "EarthTagLut",
    LabelId = "EarthLabelLut",
    Name = "Lut Desert Thermal Station",
    LabelText = "Lut Desert (Iran)",
    Globe = "Earth",
    Lat = 30.50,
    Lon = 58.80,
    Alt = 1600.0,
    LabelAlt = 4600.0,
    Color = { 1.00, 0.65, 0.10 },
    TeamMetrics = TeamData.lut.metrics
  },
  {
    SiteKey = "uyuni",
    TagId = "EarthTagUyuni",
    LabelId = "EarthLabelUyuni",
    Name = "Salar de Uyuni Station",
    LabelText = "Salar de Uyuni (Bolivia)",
    Globe = "Earth",
    Lat = -20.15,
    Lon = -67.60,
    Alt = 3700.0,
    LabelAlt = 6700.0,
    Color = { 0.85, 0.45, 1.00 },
    TeamMetrics = TeamData.uyuni.metrics
  }
}

asset.onInitialize(function()
  openspace.printInfo("Loaded Earth Desert Analogs (4 Sites) with In-Situ Metrics.")
  for _, site in ipairs(DesertSites) do
    -- 1. Adaptive Location Tag Marker (Initializes false on Mars startup)
    openspace.addSceneGraphNode({
      Identifier = site.TagId,
      Parent = site.Globe,
      Transform = {
        Translation = {
          Type = "GlobeTranslation",
          Globe = site.Globe,
          Latitude = site.Lat,
          Longitude = site.Lon,
          Altitude = site.Alt,
          UseHeightmap = true
        }
      },
      Renderable = {
        Type = "RenderablePlaneImageLocal",
        Enabled = false,
        Texture = LocationTagTexture,
        Billboard = true,
        MultiplyColor = site.Color,
        BlendMode = "Normal",
        Size = 85000,
        DistanceScalingSettings = {
          ScaleByDistance = true,
          ApparentSizeMultiplier = 0.035,
          ScaleByDistanceMaxHeight = 350000.0,
          ScaleByDistanceMinHeight = 2500.0
        }
      },
      GUI = {
        Name = site.Name .. " Pin",
        Path = "/Planets/Earth/Mars Analog Sites"
      }
    })

    -- 2. 3D Billboard Location Label on Screen (Initializes false on Mars startup, with distance fading)
    openspace.addSceneGraphNode({
      Identifier = site.LabelId,
      Parent = site.Globe,
      Transform = {
        Translation = {
          Type = "GlobeTranslation",
          Globe = site.Globe,
          Latitude = site.Lat,
          Longitude = site.Lon,
          Altitude = site.LabelAlt,
          UseHeightmap = true
        }
      },
      Renderable = {
        Type = "RenderableLabel",
        Enabled = false,
        Text = site.LabelText,
        FontSize = 32.0,
        Color = site.Color,
        MinMaxSize = { 0, 32 },
        EnableFading = true,
        FadeUnit = "km",
        FadeDistances = { 50.0, 3500.0 },
        FadeWidths = { 20.0, 1500.0 },
        OrientationOption = "Camera View Direction",
        BlendMode = "Normal"
      },
      GUI = {
        Name = site.Name .. " Label",
        Path = "/Planets/Earth/Mars Analog Sites"
      }
    })
  end
end)

asset.onDeinitialize(function()
  for _, site in ipairs(DesertSites) do
    openspace.removeSceneGraphNode(site.LabelId)
    openspace.removeSceneGraphNode(site.TagId)
  end
end)

asset.export("DesertSites", DesertSites)
asset.export("TeamData", TeamData)
