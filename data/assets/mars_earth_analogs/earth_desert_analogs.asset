local EarthBoundariesFile = asset.resource("./geojson/earth_desert_boundaries.geojson")
local EarthPinsFile = asset.resource("./geojson/earth_desert_pins.geojson")
local StationPinTexture = asset.resource("./textures/station_pin.png")

local EarthBoundariesTable = {
  Identifier = "EarthDesertBoundaries",
  File = EarthBoundariesFile,
  Enabled = true,
  HeightOffset = 1200.0,
  LineWidthScale = 4.0,
  DefaultProperties = {
    AltitudeMode = "RelativeToGround",
    Color = { 1.0, 0.85, 0.15 },
    FillColor = { 1.0, 0.85, 0.15 },
    FillOpacity = 0.28,
    LineWidth = 6.0,
    Opacity = 1.0,
    Extrude = true,
    PerformShading = false
  }
}

local EarthPinsTable = {
  Identifier = "EarthDesertPins",
  File = EarthPinsFile,
  Enabled = true,
  HeightOffset = 1500.0,
  PointRenderMode = "Camera Position",
  DefaultProperties = {
    AltitudeMode = "RelativeToGround",
    Color = { 1.0, 0.95, 0.25 },
    PointSize = 22000.0,
    PointTexture = StationPinTexture,
    PointTextureAnchor = "Center",
    Opacity = 1.0
  }
}

local DesertLabels = {
  {
    Identifier = "EarthLabelAralkum",
    Lat = 44.80,
    Lon = 59.80,
    Alt = 8000.0,
    Text = "Aralkum Desert Station (Toxic Dust / Swings)",
    Color = { 0.25, 1.00, 0.55 }
  },
  {
    Identifier = "EarthLabelMcMurdo",
    Lat = -77.50,
    Lon = 162.00,
    Alt = 8000.0,
    Text = "McMurdo Dry Valleys Station (Polar Cold)",
    Color = { 0.25, 0.85, 1.00 }
  },
  {
    Identifier = "EarthLabelLut",
    Lat = 30.50,
    Lon = 58.80,
    Alt = 8000.0,
    Text = "Lut Desert Thermal Station (Record Heat / Yardangs)",
    Color = { 1.00, 0.70, 0.15 }
  },
  {
    Identifier = "EarthLabelUyuni",
    Lat = -20.15,
    Lon = -67.60,
    Alt = 8000.0,
    Text = "Salar de Uyuni Station (Thin Air / UV Radiation)",
    Color = { 0.85, 0.55, 1.00 }
  }
}

asset.onInitialize(function()
  openspace.globebrowsing.addGeoJson("Earth", EarthBoundariesTable)
  openspace.globebrowsing.addGeoJson("Earth", EarthPinsTable)

  for _, item in ipairs(DesertLabels) do
    openspace.addSceneGraphNode({
      Identifier = item.Identifier,
      Parent = "Earth",
      Transform = {
        Translation = {
          Type = "GlobeTranslation",
          Globe = "Earth",
          Latitude = item.Lat,
          Longitude = item.Lon,
          Altitude = item.Alt,
          UseHeightmap = true
        }
      },
      Renderable = {
        Type = "RenderableLabel",
        Enabled = true,
        Text = item.Text,
        FontSize = 32.0,
        Color = item.Color,
        OrientationOption = "Camera View Direction",
        BlendMode = "Additive"
      },
      GUI = {
        Name = item.Text,
        Path = "/Planets/Earth/Mars Analog Sites"
      }
    })
  end
end)

asset.onDeinitialize(function()
  for _, item in ipairs(DesertLabels) do
    openspace.removeSceneGraphNode(item.Identifier)
  end
  openspace.globebrowsing.deleteGeoJson("Earth", EarthPinsTable)
  openspace.globebrowsing.deleteGeoJson("Earth", EarthBoundariesTable)
end)

asset.export("EarthBoundariesTable", EarthBoundariesTable)
asset.export("EarthPinsTable", EarthPinsTable)
